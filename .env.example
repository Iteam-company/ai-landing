# EasyLand client config — committed (private org). Build flags + secrets.
NEXT_PUBLIC_SITE_PALETTE=
NEXT_PUBLIC_EASYLAND_FEATURES=
# Storyblok skipped at onboarding — add the Preview token here to wire the CMS later.
NEXT_PUBLIC_STORYBLOK_TOKEN=

# Backend features (Business Calendar / Customers) — MongoDB + admin/JWT.
MONGODB_URI=
EASYLAND_CLIENT_EMAIL=
EASYLAND_DB_NAME=
ADMIN_USER=
ADMIN_PASS=
JWT_SECRET=

# Email (SMTP) — OPTIONAL. Fill to send themed booking emails; leave SMTP_HOST empty to disable.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=
EMAIL_FROM=
